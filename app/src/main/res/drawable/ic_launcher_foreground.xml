<?xml version="1.0" encoding="utf-8"?>
<!-- Crosshair with a mosquito; artwork kept inside the 66dp safe zone of the 108dp canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- crosshair ring -->
    <path
        android:pathData="M32,54a22,22 0 1,0 44,0a22,22 0 1,0 -44,0"
        android:strokeColor="#FFD84A"
        android:strokeWidth="3" />
    <!-- crosshair ticks -->
    <path
        android:pathData="M54,25v12M54,71v12M25,54h12M71,54h12"
        android:strokeColor="#FFD84A"
        android:strokeLineCap="round"
        android:strokeWidth="3" />

    <!-- wings -->
    <group
        android:pivotX="52"
        android:pivotY="50"
        android:rotation="-52">
        <path
            android:fillAlpha="0.75"
            android:fillColor="#DFEEFF"
            android:pathData="M48,39a4,11 0 1,0 8,0a4,11 0 1,0 -8,0" />
    </group>
    <group
        android:pivotX="56"
        android:pivotY="50"
        android:rotation="52">
        <path
            android:fillAlpha="0.75"
            android:fillColor="#DFEEFF"
            android:pathData="M52,39a4,11 0 1,0 8,0a4,11 0 1,0 -8,0" />
    </group>

    <!-- abdomen -->
    <path
        android:fillColor="#8A6A4A"
        android:pathData="M51,61a3,9 0 1,0 6,0a3,9 0 1,0 -6,0" />
    <!-- thorax -->
    <path
        android:fillColor="#C9A27A"
        android:pathData="M50,51a4,5 0 1,0 8,0a4,5 0 1,0 -8,0" />
    <!-- head -->
    <path
        android:fillColor="#C9A27A"
        android:pathData="M51,44.5a3,3 0 1,0 6,0a3,3 0 1,0 -6,0" />
    <!-- proboscis -->
    <path
        android:pathData="M54,42v-7"
        android:strokeColor="#C9A27A"
        android:strokeLineCap="round"
        android:strokeWidth="1.2" />
    <!-- eyes -->
    <path
        android:fillColor="#E74C3C"
        android:pathData="M51.6,44a1,1 0 1,0 2,0a1,1 0 1,0 -2,0M54.4,44a1,1 0 1,0 2,0a1,1 0 1,0 -2,0" />
